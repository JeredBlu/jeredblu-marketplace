[
  {
    "id": "1",
    "title": "1. Remote execution (download-and-run)",
    "pattern": "curl[^|]*\\|[^|]*(ba|z)?sh|wget[^|]*\\|[^|]*(ba|z)?sh|iwr[^|]*\\|[^|]*iex|invoke-expression|downloadstring\\(|bash -c[^)]*curl|\\$\\((curl|wget)|exec\\(.*(urlopen|requests\\.get)|eval\\(.*(fetch|urlopen|requests\\.get)",
    "scope": "all"
  },
  {
    "id": "2",
    "title": "2. Install-time hooks / quarantine bypass",
    "pattern": "\"(pre|post)?install\" *:|\"prepare\" *:|\"prepublish\" *:|cmdclass|postflight|post_install|preflight|binding\\.gyp|xattr +-[a-z]*d[a-z]* +com\\.apple\\.quarantine|--no-quarantine|spctl +--master-disable",
    "scope": "all"
  },
  {
    "id": "3",
    "title": "3. Persistence (runs at login / on schedule)",
    "pattern": "launchagents|launchdaemons|launchctl +(load|bootstrap|enable|submit)|smappservice|lssharedfilelist|smloginitem|crontab|cron\\.d|systemctl +(--user +)?enable|wantedby=|currentversion\\\\+run|schtasks|>> *[\"~$a-z/{}]*\\.(zshrc|bashrc|bash_profile|zprofile|profile)",
    "scope": "all"
  },
  {
    "id": "4",
    "title": "4. Privilege escalation / security-setting changes",
    "pattern": "(^|[^a-z])sudo +|authorizationexecutewithprivileges|with administrator privileges|chmod +[0-7]*4[0-7]{3}|chmod +[ug]\\+s|setuid\\(|csrutil|kextload|systemextensions|smjobbless|tccutil|spctl +--(add|enable|disable)",
    "scope": "code"
  },
  {
    "id": "5",
    "title": "5. Destructive commands",
    "pattern": "rm\\s+-(?:[a-z]*r[a-z]*f[a-z]*|[a-z]*f[a-z]*r[a-z]*)\\s+['\"]?(?:/|~|\\$home|\\$\\{home\\})(?:[/\\s'\"]|$)|diskutil +(erase|zerodisk|secureerase)|mkfs|dd +if=[^ ]+ +of=/dev/|shred +|format +c:",
    "scope": "code"
  },
  {
    "id": "6",
    "title": "6. Credential / secret-store access",
    "pattern": "gh auth token|\\.aws/credentials|id_rsa|id_ed25519|\\.ssh/(id|config|known)|security +(find|dump)-(generic-password|internet-password|keychain)|keychains/|secitemcopymatching|gcloud auth print|aws_secret_access_key|\\.npmrc|\\.pypirc|\\.netrc|\\.docker/config\\.json|\\.kube/config|login data|key4\\.db|logins\\.json|cookies\\.sqlite|local state\"|wallet\\.dat|nkbihfbeogaeaoehlefnkodbefgpgknn|(open|read|source|load)[^;|]{0,30}[^a-z]\\.env([^a-z]|$)",
    "scope": "code"
  },
  {
    "id": "7",
    "title": "7. Surveillance capability (keys / screen / clipboard / mic / cam)",
    "pattern": "cgeventtapcreate|addglobalmonitorforevents|pynput|keyboard\\.on_press|setwindowshookex|getasynckeystate|iohidmanager|cgwindowlistcreateimage|scstream|screencapturekit|imagegrab|screencapture +-|avcapturedevice|getusermedia|pbpaste|pyperclip\\.paste|clipboard\\.readtext|getclipboarddata|pasteboard\\.(string|data|readobjects)\\(",
    "scope": "code"
  },
  {
    "id": "8",
    "title": "8. Telemetry / analytics / crash-report SDKs",
    "pattern": "posthog|api\\.segment\\.io|analytics-node|mixpanel|amplitude\\.com|@amplitude|@sentry/|sentry_sdk|sentry\\.io|sentry-cocoa|google-analytics\\.com|googletagmanager|gtag\\(|datadoghq|bugsnag|rudderstack|plausible\\.io|umami|countly|appcenter\\.ms|firebase.?analytics|heapanalytics|telemetry|analytics|usage.?stats|/v[0-9]/(track|events|collect)",
    "scope": "code"
  },
  {
    "id": "8b",
    "title": "8b. Telemetry off-switches (use to decide: on by default or opt-in?)",
    "pattern": "no_analytics|do_not_track|donottrack|disable_telemetry|telemetry_disabled|no_telemetry|telemetry_opt|analytics_opt|opt.?out",
    "scope": "all"
  },
  {
    "id": "9",
    "title": "9. Phone-home / exfil endpoints (webhooks, raw IPs, tunnels, paste sites)",
    "pattern": "discord(app)?\\.com/api/webhooks|hooks\\.slack\\.com|api\\.telegram\\.org/bot|webhook\\.site|requestbin|pipedream\\.net|ngrok(-free)?\\.(io|app)|pastebin\\.com|transfer\\.sh|interact\\.sh|oast\\.(fun|pro|live|site|online|me)|burpcollaborator|duckdns\\.org|no-ip\\.|ddns\\.net|https?://[0-9]{1,3}(\\.[0-9]{1,3}){3}",
    "scope": "code"
  },
  {
    "id": "10",
    "title": "10. Auto-update / downloads code later (bypasses this review)",
    "pattern": "sparkle|sufeedurl|autoupdater|electron-updater|self[-_]?update|check_?for_?updates|update[-_]?check|releases/latest",
    "scope": "code"
  },
  {
    "id": "11",
    "title": "11. Opens browser / URLs at runtime",
    "pattern": "webbrowser\\.open|shell\\.openexternal|nsworkspace\\.shared\\.open\\(|xdg-open|(^|[^a-z])open +\"?https?:|start +https?:",
    "scope": "code"
  },
  {
    "id": "12",
    "title": "12. Auto-star / auto-follow your GitHub account",
    "pattern": "/user/starred/|/user/following/|starred/[a-z0-9_.-]+/[a-z0-9_.-]+|gh +repo +star|gh api +-x +put",
    "scope": "all"
  },
  {
    "id": "13",
    "title": "13. Self-promo / affiliate / monetization in CODE (docs excluded)",
    "pattern": "[?&](ref|aff|affiliate|referral|refcode)=[a-z0-9_-]+|amzn\\.to|tag=[a-z0-9-]+-20|utm_source=|star (this|the|our) repo|give (us|it) a star|buymeacoffee|ko-fi\\.com|patreon\\.com|gumroad|opencollective|skool\\.com|github\\.com/sponsors",
    "scope": "code"
  },
  {
    "id": "14",
    "title": "14. Branding injected into user output",
    "pattern": "powered by [a-z0-9]|made with (love|\u2764|\u2665)|\ud83e\udd16 generated|generated (by|with) \\[|\\(generated (by|with) ",
    "scope": "code"
  },
  {
    "id": "15",
    "title": "15. Obfuscation / dynamic eval / shell-out",
    "pattern": "eval\\(function\\(p,a,c,k,e|b64decode|atob\\(|fromcharcode|marshal\\.loads|zlib\\.decompress|pickle\\.loads|codecs\\.decode|new function\\(|(^|[^a-z_.])eval\\(|(^|[^a-z_.])exec\\(|os\\.system|shell *= *true|child_process|([a-z0-9+/]{100}){3,}",
    "scope": "code"
  },
  {
    "id": "16",
    "title": "16. Crypto-mining",
    "pattern": "stratum\\+tcp|xmrig|coinhive|cryptonight|minexmr|nicehash|--donate-level",
    "scope": "all"
  },
  {
    "id": "17",
    "title": "17. Dev-environment triggers (run when you open/clone the folder)",
    "pattern": "\"runon\" *: *\"folderopen\"|postcreatecommand|poststartcommand|postattachcommand|pull_request_target",
    "scope": "all"
  },
  {
    "id": "24",
    "title": "24. Agent instruction / prompt-injection leads",
    "pattern": "ignore (all |any |the )?(previous|prior|system|developer) instructions|do not (report|mention|inspect)|hide (this|these|the) (finding|issue|vulnerabilit)|override.{0,30}(instruction|policy|safety)|send.{0,80}(api.key|token|credential)|disable.{0,30}(security|safety).{0,30}(check|scan)",
    "scope": "all"
  }
]
